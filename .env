# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://localhost:8002
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> OIDC demo (symfony/symfony#64954) ###
OIDC_PROVIDER_URI=https://security.spomky-labs.net/realms/spomky-labs
OIDC_CLIENT_ID=demo
# the real secret lives in .env.local, which is not committed
OIDC_CLIENT_SECRET=
# How the provider answers an authorization request: "query" (the default of the code
# flow) or "form_post" (OAuth 2.0 Form Post Response Mode), which is why the session
# cookie of config/packages/framework.yaml is "SameSite=None"
OIDC_RESPONSE_MODE=query
# Where the resource server half of this demonstration introspects the access tokens it
# is presented with (RFC 7662 section 2.1). It is the "introspection_endpoint" of the
# provider, which "castor demo" reads from its discovery document.
# The identifier of this resource server (RFC 8707 section 2), which the "aud" of a token presented to
# /api/service is compared with: what a service asked its token for, and not the client identifier of the
# firewalls that sign a user in. Written by "castor demo --service" of the provider.
OIDC_RESOURCE=
OIDC_INTROSPECTION_URI=https://security.spomky-labs.net/realms/spomky-labs/protocol/openid-connect/token/introspect
###< OIDC demo (symfony/symfony#64954) ###

###> ladder of demonstration clients (heidi#201) ###
# One rung is one client registered on the provider and one firewall here
# (config/packages/security.yaml, src/Ladder/Rungs.php). "castor provision" of the code repository
# generates the secrets and the keys, and "castor demo" writes them into .env.local, which is not
# committed; the values below are empty on purpose, and a rung whose value is missing says so instead of
# signing in.
# Where this demonstration answers, as the provider knows it: a redirect URI is compared byte for byte
# (RFC 6749 section 3.1.2.3), so it is written here and not derived from DEFAULT_URI, which the Symfony
# CLI server overwrites with an address of its own ("https://127.0.0.1:8002/"). No trailing slash.
DEMO_BASE_URI=https://localhost:8002
DEMO_BASIC_CLIENT_ID=oidc-demo
DEMO_BASIC_SECRET=
DEMO_OPAQUE_CLIENT_ID=oidc-demo-opaque
DEMO_OPAQUE_SECRET=
DEMO_FORM_POST_CLIENT_ID=demo-form-post
DEMO_FORM_POST_SECRET=
DEMO_KEY_CLIENT_ID=demo-key
# base64 of the private JWK the client signs its assertions with, so that a dotenv line stays one
DEMO_KEY_JWK=
DEMO_FAPI_CLIENT_ID=demo-fapi
DEMO_FAPI_JWK=
# base64 of the private JWK the provider encrypts the ID token and UserInfo to
DEMO_FAPI_ENCRYPTION_JWK=
###< ladder of demonstration clients (heidi#201) ###
