<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Beffroi demo{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
        <meta name="theme-color" content="#f2f4f6">
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="topbar">
            <a class="brand" href="{{ path('app_home') }}">
                <img src="{{ asset('images/beffroi-lockup-S-bichrome.svg') }}" alt="Beffroi">
                <span>Demo</span>
            </a>
            <span class="provider" title="The provider every client here signs in at">
                <span class="sq {{ provider.reachable ? 'ok' : 'ko' }}"></span>{{ provider.issuer }}
            </span>
            <nav>
                {% block topbar_nav %}
                    {% if app.user %}<span class="who">{{ app.user|signed_in_name }}</span>{% endif %}
                    <a class="to-tree" href="#features">Features</a>
                    <a href="{{ path('app_profile') }}">Profile</a>
                    <a href="{{ path('app_api_calls') }}">API calls</a>
                    <a href="{{ path('app_forge') }}">Forge</a>
                    {% if app.user %}
                        {# a logout is posted, never followed as a link #}
                        <form class="logout" method="post" action="{{ logout_path('main') }}">
                            <button class="button small" type="submit">Sign out</button>
                        </form>
                    {% else %}
                        <a class="button small primary" href="{{ path('app_profile') }}">Sign in</a>
                    {% endif %}
                {% endblock %}
            </nav>
        </header>

        <div class="shell">
            {% include 'showcase/_tree.html.twig' %}
            <main class="panel">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
