{% extends '@!ApiPlatform/SwaggerUi/index.html.twig' %}

{# Swagger UI signs in as the client the demonstration registered for it, whose identifier is known only
   once it is registered (src/Showcase/Api/SwaggerClient.php): it is written here, when the page is
   rendered, and not in the configuration of API Platform, which fixes it when the container is built. #}
{% block head_javascript %}
    {% set oauth = swagger_data.oauth|merge({
        clientId: swagger_client.clientId ?? '',
        redirectUrl: absolute_url(constant('App\\Showcase\\Api\\SwaggerClient::REDIRECT')),
    }) %}
    {# json_encode(65) is JSON_UNESCAPED_SLASHES|JSON_HEX_TAG, as the original writes it #}
    <script id="swagger-data" type="application/json">{{ swagger_data|merge({oauth: oauth})|json_encode(65)|raw }}</script>
{% endblock %}

{% block header %}
    <header>
        <a id="logo" href="{{ path('app_feature', {slug: 'swagger'}) }}" style="color: #fff; font-weight: 600; text-decoration: none;">← Beffroi demo</a>
    </header>
{% endblock %}

{# Two things Swagger UI does that the provider refuses, mended on the instance the script of API Platform
   builds. It asks only for the scopes ticked in its dialog, and the provider refuses an authorization
   request without "openid" (OIDC Core section 3.1.2.1): "openid" is selected beforehand. It adds
   "X-Requested-With" to its token request, a header the provider does not allow across origins, so the
   preflight of that request fails and the code is never exchanged: the header is taken out. #}
{% block javascript %}
    {{ parent() }}
    <script>
        (() => {
            const build = window.SwaggerUIBundle;
            window.SwaggerUIBundle = Object.assign((config) => {
                const intercept = config.requestInterceptor ?? ((request) => request);
                const ui = build({...config, requestInterceptor: (request) => {
                    delete request.headers['X-Requested-With'];

                    return intercept(request);
                }});
                const initOAuth = ui.initOAuth;
                ui.initOAuth = (options) => initOAuth({...options, scopes: ['openid']});

                return ui;
            }, build);
        })();
    </script>
{% endblock %}
