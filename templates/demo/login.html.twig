{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <h1>Sign in</h1>

    {% if error %}
        <div class="card error">
            <h2>Authentication failed</h2>
            <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            <p class="muted">Detail: <code>{{ error.message }}</code></p>
        </div>
    {% else %}
        <div class="card">
            <p>You are not authenticated.</p>
        </div>
    {% endif %}

    <p><a class="button" href="{{ path('app_profile') }}">Sign in through {{ provider_uri }}</a></p>
{% endblock %}
