{% extends 'base.html.twig' %}

{% block title %}OIDC profile{% endblock %}

{% block body %}
    <h1>Profile</h1>
    <p class="lead">The identity comes from the verified <code>sub</code> claim, the claims from the UserInfo endpoint.</p>

    <div class="card ok">
        <table class="kv">
            <tr><th>user identifier</th><td><code>{{ user.userIdentifier }}</code></td></tr>
            <tr><th>class</th><td><code>{{ user_class }}</code></td></tr>
            <tr><th>roles</th><td>{% for role in user.roles %}<code>{{ role }}</code> {% endfor %}</td></tr>
        </table>
    </div>

    <h2>Standard claims</h2>
    <table class="kv">
        {% for claim, value in claims %}
            <tr><th>{{ claim }}</th><td><code>{{ value is iterable ? value|json_encode : value }}</code></td></tr>
        {% endfor %}
    </table>

    {% if additional_claims is not empty %}
        <h2>Additional claims</h2>
        <table class="kv">
            {% for claim, value in additional_claims %}
                <tr><th>{{ claim }}</th><td><code>{{ value is iterable ? value|json_encode : value }}</code></td></tr>
            {% endfor %}
        </table>
    {% endif %}

    <h2>ID token</h2>
    <p class="muted">Validated by the authenticator: <code>iss</code>, <code>aud</code>, <code>exp</code>, <code>iat</code>, <code>nbf</code>, <code>nonce</code>, <code>azp</code>.</p>
    <pre>{{ id_token_claims|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>
    <details><summary>Raw JWT</summary><pre class="jwt">{{ id_token }}</pre></details>

    <h2>Access token</h2>
    <pre>{{ access_token_claims|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>
    <details><summary>Raw JWT</summary><pre class="jwt">{{ access_token }}</pre></details>
{% endblock %}
