{% extends 'base.html.twig' %}

{% block title %}{{ definition.name }}{% endblock %}

{% block topbar_nav %}
    <span class="who">{{ app.user.userIdentifier }}</span>
    <a href="{{ path('app_home') }}">The ladder</a>
    {# the pages of the "main" firewall, which holds a session of its own: following one of them from here
       signs in there, and the token of this rung works on the API all the same (/api-calls) #}
    <a href="{{ path('app_api_calls') }}">API calls</a>
    <form class="logout" method="post" action="{{ logout_path(definition.firewall) }}">
        <button class="button" type="submit">Sign out</button>
    </form>
{% endblock %}

{% block body %}
    <h1>{{ definition.name }} <code>{{ definition.client }}</code></h1>
    <p class="lead">{{ definition.adds }}</p>

    <div class="card ok">
        <h2>Session open</h2>
        <p>Signed in as <strong>{{ app.user.userIdentifier }}</strong>, on the firewall
            <code>{{ definition.firewall }}</code>. The other rungs keep theirs: every firewall holds a
            session of its own.</p>
    </div>

    <h2>What this rung registered</h2>
    <table class="kv">
        {% for what, how in definition.capabilities %}
            <tr><th>{{ what }}</th><td>{{ how }}</td></tr>
        {% endfor %}
    </table>

    {% if observations %}
        <h2>What the login did</h2>
        <table class="kv">
            {% for observation in observations %}
                <tr><th>{{ observation.0 }}</th><td>{{ observation.1 }}</td></tr>
            {% endfor %}
        </table>
    {% endif %}

    <h2>Claims</h2>
    <table class="kv">
        {% for claim, value in claims %}
            <tr><th>{{ claim }}</th><td>{{ value is iterable ? value|json_encode : value }}</td></tr>
        {% else %}
            <tr><td colspan="2">No claim beyond the identifier.</td></tr>
        {% endfor %}
    </table>

    {% set tokens = fapi_tokens ?? null %}
    <h2>Tokens</h2>
    {% if tokens %}
        <h3>Pushed request object</h3>
        <p>Sent to the <code>/par</code> endpoint, never to the browser. <code>{{ tokens.request_uri }}</code></p>
        <pre class="jwt" data-jwt="request_object">{{ tokens.request_object }}</pre>

        <h3>Signed authorization response (JARM)</h3>
        <pre class="jwt" data-jwt="authorization_response">{{ tokens.authorization_response }}</pre>

        <h3>ID token, as it arrived</h3>
        <p>Encrypted to the key of this client, then signed by the provider: what follows cannot be read
            without the client's private key.</p>
        <pre class="jwt" data-jwt="id_token">{{ tokens.id_token }}</pre>

        <h3>Access token</h3>
        <p>Type <code>{{ tokens.token_type }}</code>, bound to the key <code>{{ tokens.jkt }}</code>.</p>
        <pre class="jwt" data-jwt="access_token">{{ tokens.access_token }}</pre>
    {% else %}
        <h3>ID token</h3>
        <pre class="jwt" data-jwt="id_token">{{ id_token }}</pre>
        <h3>Access token</h3>
        <pre class="jwt" data-jwt="access_token">{{ access_token }}</pre>
        {% if authorization_details is not empty %}
            <h3>What this token grants beyond its scopes</h3>
            <p>RFC 9396 §7: the detail as its type built it, members and lists in the order of that type
                and not in the order of the request, which is what lets one consent cover two requests
                asking for the same thing. A resource server is what applies it, not this page.</p>
            <ul>
                {% for detail in authorization_details %}
                    <li data-authorization-detail="{{ detail.type|default('') }}">
                        <code>{{ detail|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if rung == 'opaque' %}
            <p class="note">Nothing to read in it: it is a reference only the provider can resolve. A
                resource server asks the provider what it is on every request (RFC 7662), so a revocation
                is felt at once.</p>
        {% endif %}
    {% endif %}

    <p><a href="{{ path('app_home') }}">Back to the ladder</a></p>
{% endblock %}
